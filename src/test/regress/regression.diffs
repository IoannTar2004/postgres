-select
-	x, y,
-	jsonb_path_query(
-		'[true, false, null]',
-		'$[*] ? (@ == true  &&  ($x == true && $y == true) ||
-				 @ == false && !($x == true && $y == true) ||
-				 @ == null  &&  ($x == true && $y == true) is unknown)',
-		jsonb_build_object('x', x, 'y', y)
-	) as "x && y"
-from
-	(values (jsonb 'true'), ('false'), ('"null"')) x(x),
-	(values (jsonb 'true'), ('false'), ('"null"')) y(y);
-   x    |   y    | x && y 
---------+--------+--------
- true   | true   | true
- true   | false  | false
- true   | "null" | null
- false  | true   | false
- false  | false  | false
- false  | "null" | false
- "null" | true   | null
- "null" | false  | false
- "null" | "null" | null
