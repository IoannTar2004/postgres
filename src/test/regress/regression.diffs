--- test order of firing of FK triggers when several RI-induced changes need to
--- be made to the same row.  This was broken by subtransaction-related
--- changes in 8.0.
-CREATE TEMP TABLE users (
-  id INT PRIMARY KEY,
-  name VARCHAR NOT NULL
-);
