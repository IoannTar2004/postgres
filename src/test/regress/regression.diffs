-  7 | 20368 |  4489
-  8 | 24857 |  4489
-  9 | 29346 |  4489
- 10 | 11055 |  4489
- 11 | 15246 |  4356
- 12 | 19602 |  4356
- 13 | 23958 |  4356
- 14 | 28314 |  4356
-(15 rows)
