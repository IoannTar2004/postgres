-FROM (VALUES (3, 2), (3,1), (1,1), (1,4), (5,3), (5,1)) AS t(a, b)
-ORDER BY a, b DESC, g DESC;
- a | b | g 
----+---+---
- 1 | 4 | 3
- 1 | 4 | 2
- 1 | 4 | 1
- 1 | 1 | 3
- 1 | 1 | 2
- 1 | 1 | 1
- 3 | 2 | 3
- 3 | 2 | 2
- 3 | 2 | 1
- 3 | 1 | 3
- 3 | 1 | 2
- 3 | 1 | 1
- 5 | 3 | 3
- 5 | 3 | 2
- 5 | 3 | 1
- 5 | 1 | 3
- 5 | 1 | 2
- 5 | 1 | 1
-(18 rows)
