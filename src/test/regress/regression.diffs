-                                 ->  Hash Join
-                                       Output: t2.c, t2.b, t3.c
-                                       Hash Cond: (t3.a = t2.a)
-                                       ->  Seq Scan on public.eager_agg_t3 t3
-                                             Output: t3.a, t3.b, t3.c
-                                       ->  Hash
-                                             Output: t2.c, t2.b, t2.a
