-select * from rtest_v1;
- a | b  
----+----
- 2 | 99
- 1 | 88
- 3 | 88
-(3 rows)
-
-delete from rtest_v1;
-insert into rtest_v1 select rtest_t2.a, rtest_t3.b
-    from rtest_t2, rtest_t3
-    where rtest_t2.a = rtest_t3.a;
