-  SELECT (cte.r).column2 AS col_a,                         +
-     (ss.rr).column2 AS col_b                              +
-    FROM cte                                               +
-      JOIN ( SELECT rr.*::record AS rr                     +
-            FROM ( VALUES (1,7), (3,8)) rr                 +
-          LIMIT 2) ss ON (cte.r).column1 = (ss.rr).column1;
