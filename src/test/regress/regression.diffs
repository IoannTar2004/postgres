-RETURNS text
-BEGIN ATOMIC
-  DELETE FROM for_portion_of_test
-    FOR PORTION OF valid_at (daterange('2018-01-15', '2020-01-01') * daterange('2019-01-01', '2022-01-01'))
-    RETURNING name;
-END;
-\sf+ fpo_delete()
