-		('[]'),
-		('[null]'),
-		('[12.3]'),
-		('[true]'),
-		('["aaa"]'),
-		('[[1, 2, 3]]'),
-		('[{"a": 1, "b": [2]}]'),
-		('[1, "2", null, [3]]')
-	) foo(js);
