-RETURNS text
-BEGIN ATOMIC
-  DELETE FROM for_portion_of_test
-    FOR PORTION OF valid_at FROM '2018-01-15' TO '2019-01-01'
-    RETURNING name;
-END;
-\sf+ fpo_delete()
