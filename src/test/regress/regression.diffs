-
--- viewpoint from regress_graph_rls_carol
-SET SESSION AUTHORIZATION regress_graph_rls_carol;
-EXECUTE graph_rls_query;
-NOTICE:  f_leak => Politicians
-NOTICE:  f_leak => Scientists
-NOTICE:  f_leak => Paris
