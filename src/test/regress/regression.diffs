-NOTICE:  BEFORE DELETE ROW trigger row: (2,20)
-NOTICE:  BEFORE INSERT ROW trigger row: (4,40)
-NOTICE:  AFTER DELETE STATEMENT trigger
-NOTICE:  AFTER UPDATE STATEMENT trigger
-NOTICE:  AFTER INSERT STATEMENT trigger
-NOTICE:  Not found
-NOTICE:  ROW_COUNT = 0
