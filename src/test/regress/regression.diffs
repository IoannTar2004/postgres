-         RETURNS text
-         LANGUAGE sql
-1       BEGIN ATOMIC
-2        DELETE FROM for_portion_of_test FOR PORTION OF valid_at FROM '2018-01-15' TO '2019-01-01'
-3          RETURNING for_portion_of_test.name;
-4       END
