-WITH aaa AS (SELECT 1 AS ctea, ' Foo' AS cteb) INSERT INTO upsert_test
-  VALUES (1, 'Bar'), (2, 'Baz') ON CONFLICT(a)
-  DO UPDATE SET (b, a) = (SELECT upsert_test.b||cteb, upsert_test.a FROM aaa) RETURNING *;
- a |    b    
----+---------
- 1 | Foo Foo
- 2 | Zoo Foo
