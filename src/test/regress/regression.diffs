-   ->  WindowAgg
-         Window: w2 AS ()
-         ->  WindowAgg
-               Window: w1 AS (PARTITION BY (((empsalary.depname)::text || 'A'::text)))
-               ->  Sort
-                     Sort Key: (((empsalary.depname)::text || 'A'::text))
-                     ->  Seq Scan on empsalary
-                           Filter: ((depname)::text = 'sales'::text)
-(9 rows)
