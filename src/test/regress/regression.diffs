-    END IF;
-    RETURN NULL;
-END$$;
-CREATE AGGREGATE balk(int4)
-(
-    SFUNC = balkifnull(int8, int4),
-    STYPE = int8,
-    PARALLEL = SAFE,
-    INITCOND = '0'
-);
