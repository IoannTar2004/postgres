--- do an indexscan
--- make sure it is not a bitmap scan, which might skip fetching heap tuples
-SET enable_bitmapscan TO off;
-SELECT count(*) FROM tenk2 WHERE unique1 = 1;
- count 
--------
-     1
-(1 row)
-
-RESET enable_bitmapscan;
