-    (22, 'science fiction'),
-    (33, 'technology'),
-    (44, 'manga');
-CREATE TABLE document (
-    did         int primary key,
-    cid         int references category(cid),
-    dlevel      int not null,
-    dauthor     name,
-    dtitle      text
-);
