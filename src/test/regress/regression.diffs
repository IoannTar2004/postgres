-SELECT * FROM quad_point_tbl_ord_seq3 seq FULL JOIN kd_point_tbl_ord_idx3 idx
-ON seq.n = idx.n
-WHERE seq.dist IS DISTINCT FROM idx.dist;
- n | dist | p | n | dist | p 
