-values
-    (0, 0),
-    (1, 1);
-begin;
-    update selfref set a = 123 where a = 0;
-    select a, b from selfref;
-  a  |  b  
------+-----
-   1 |   1
- 123 | 123
-(2 rows)
-
-    update selfref set a = 456 where a = 123;
-    select a, b from selfref;
